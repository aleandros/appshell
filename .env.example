DATABASE_URL=postgres://appshell:appshell@localhost:5433/appshell
APP_URL=http://localhost:5173
APP_ENV=development
PORT=8080
RUN_MODE=combined
MAIL_MODE=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=AppShell <hello@appshell.test>
MAIL_BRAND=AppShell
# Open captured mail at http://localhost:8025. Use MAIL_MODE=console for text logs.
# Production email delivery (HTTPS works on free hosting):
# MAIL_MODE=resend
# MAIL_FROM=Your App <hello@your-verified-domain.com>
# RESEND_API_KEY=re_...
# Optional paid subscriptions: one monthly flat-rate price, up to 50 seats.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STATIC_DIR=apps/web/dist

# Admin credentials are never environment defaults. Provision the first account with:
# python3 scripts/bootstrap-admin.py (or --local with DATABASE_URL exported).
