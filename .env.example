DATABASE_URL=postgres://appshell:appshell@localhost:5433/appshell
APP_URL=http://localhost:5173
APP_ENV=development
PORT=8080
RUN_MODE=combined
# Optional shared jobs: disabled (legacy email), postgres (Docker), sqs (Lambda).
JOB_BACKEND=disabled
# SQS queue URL is injected by the Lambda template. Never required for Docker.
# JOBS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/queue
# Maximum Postgres connections per process; Lambda template uses 2.
DB_POOL_SIZE=8
MAIL_MODE=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=AppShell <hello@appshell.test>
MAIL_BRAND=AppShell
# Open captured mail at http://localhost:8025. Use MAIL_MODE=console for text logs.
# Production email delivery (HTTPS works on free hosting):
# MAIL_MODE=resend
# MAIL_FROM=Your App <hello@your-verified-domain.com>
# RESEND_API_KEY=re_...
# Optional paid subscriptions: one monthly flat-rate price, up to 50 seats.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STATIC_DIR=apps/web/dist

# Admin credentials are never environment defaults. Provision the first account with:
# python3 scripts/bootstrap-admin.py (or --local with DATABASE_URL exported).

# Deployment choice: Docker (default) or static frontend + Lambda + Neon.
# See deploy/lambda/README.md. Lambda supports RUN_MODE=api, worker, migrate, sqs, dispatcher;
# migrations and mail run as separate invocations, never background tasks.
# Use a pooled Neon DATABASE_URL with sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
# for Lambda API/mail, and a direct owner connection for the migration function.
# Leave VITE_API_URL unset for the same-origin CloudFront /api proxy.

# Convenience deployment commands: npm run setup / deploy:plan / deploy.
# Settings live in committed appshell.deploy.json; credentials do not.
# Render deployment requires RENDER_API_KEY in the shell or GitHub secret store.
# Lambda deployment uses AWS CLI credentials locally and an OIDC role in GitHub.
# Deployment scripts do not load .env files. Runtime secrets stay with the host.
